    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst c = (r.contacts && r.contacts[0]) ? r.contacts[0] : (r.contact || r);\nconst cf = id => { const f = (c.customFields || []).find(x => x.id === id); return f ? f.value : ''; };\n\nconst n = $('Normalize').item.json;\nconst is_bounce = n.event_type === 'email_bounced';\n\nconst EMAIL_STEP_NAME_ID = 'WtFfl1nEbMupk2oR4m9e';\nconst STOP_EMAILS_ID     = 'ixRO9dSUHVd6vNTdFa7Q';\nconst EMAIL_PIPELINE_ID  = '1A1RkYaL93s2rqbQ3Opi';\n\n// Bounce target — the same \"Cold Email N Sent\" map `Email Sent -> Move To Sent Stage` uses.\nconst SENT_STAGE = {\n  1: '41849471-6f42-4f40-9692-bbd4d3713d17',   // Cold Email 1 Sent\n  2: 'fdd4f9a4-a626-4866-a904-5053e626306f',   // Cold Email 2 Sent\n  3: '2f599547-4a2b-4ba4-850d-0feb7fcc976c',   // Cold Email 3 Sent\n  4: '39a20e88-ce88-46c6-9e95-8134aa9f269d'    // Cold Email 4 Sent\n};\n// Fallback when email_step_name is empty/stale: derive N from where the email opp sits NOW.\n// Both the `Cold Email N` and `Cold Email N Sent` stage of a step map to the same N.\nconst N_BY_STAGE = {\n  'f9bcbefb-aa83-44d4-ad8b-59a758993045': 1,   // Cold Email 1\n  '41849471-6f42-4f40-9692-bbd4d3713d17': 1,   // Cold Email 1 Sent\n  'e4b13f51-2229-4d47-aa3e-12381a31a8c1': 2,   // Cold Email 2\n  'fdd4f9a4-a626-4866-a904-5053e626306f': 2,   // Cold Email 2 Sent\n  '342b193f-9456-4bcc-a2a7-cb81973500c9': 3,   // Cold Email 3\n  '2f599547-4a2b-4ba4-850d-0feb7fcc976c': 3,   // Cold Email 3 Sent\n  'f3ea4cd2-daf2-4ca2-baaa-301f807d697c': 4,   // Cold Email 4\n  '39a20e88-ce88-46c6-9e95-8134aa9f269d': 4    // Cold Email 4 Sent\n};\n\n// The move is scoped to the EMAIL pipeline on purpose: once the 4:30AM sweep has handed the\n// opp off to a call pipeline there is no email opp left, and a late bounce must NOT yank an\n// actively-called lead back into `Cold Email N Sent`.\nconst oppList  = Array.isArray(c.opportunities) ? c.opportunities : [];\nconst emailOpp = oppList.find(o => o && o.pipelineId === EMAIL_PIPELINE_ID) || {};\nconst email_opp_id       = String(emailOpp.id || '');\nconst email_opp_stage_id = String(emailOpp.pipelineStageId || emailOpp.stageId || '');\n\nconst email_step_name = String(cf(EMAIL_STEP_NAME_ID) || '').trim();\nconst stepN = Number((email_step_name.toLowerCase().match(/^cold email (\\d+)$/) || [])[1] || 0)\n           || N_BY_STAGE[email_opp_stage_id] || 0;\n\n// Only a bounce routes anywhere; an open just tags.\nconst target_sent_stage_id = (is_bounce && SENT_STAGE[stepN]) ? SENT_STAGE[stepN] : '';\n\nreturn { json: {\n  contact_id: (c && c.id) ? String(c.id) : '',\n  tag: n.tag,\n  event_type: n.event_type,\n  is_bounce,\n  email_step_name,\n  email_opp_id,\n  email_opp_stage_id,\n  step_n: stepN,\n  target_sent_stage_id,\n  // Stop Emails is a radio field — the string 'True' is the option value, not a boolean.\n  stop_emails_fields: [{ id: STOP_EMAILS_ID, value: 'True' }]\n}};\n"
      },
