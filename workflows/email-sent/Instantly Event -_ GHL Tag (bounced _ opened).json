      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = ($json && $json.body) ? $json.body : $json;\nconst ev = String(b.event_type || '').trim();\n// Map Instantly event -> GHL tag to add. Extend this map for more events later.\nconst MAP = {\n  email_bounced: 'email_bounced',\n  email_opened:  'email_opened'\n};\nreturn { json: {\n  event_type: ev,\n  email: String(b.lead_email || b.email || '').trim(),\n  tag: MAP[ev] || ''\n}};\n"
      },
