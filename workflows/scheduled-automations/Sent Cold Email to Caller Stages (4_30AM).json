      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cr = $json;\nconst c = cr.contact ? cr.contact : cr;\nconst cf = id => { const f = (c.customFields || []).find(x => x.id === id); return f ? f.value : ''; };\n\nconst pre = $('Detect Pre').item.json;\nconst N = pre.N;                     // 1|2|3 = which \"Cold Email N Sent\" stage the lead came from\nconst email_opp_id = pre.email_opp_id;\n\n// ---- routing axes (independent) --------------------------------------------\n// is_missed: the last call went unanswered (tag set by the missed-call flow)\nconst tags = Array.isArray(c.tags) ? c.tags : [];\nconst isMissed = tags.some(t => t === 'last_call_missed');\n// is_mgr: MGR = \"missed call Google review\" lead -> 'Missed Call Review' custom field is non-empty\nconst MGR_ID = 'u9UymBEMP3f7IZqDTwVd';\nconst isMGR = String(cf(MGR_ID) || '').trim() !== '';\n\n// ---- target stage (Cold Outbound Call Pipeline 9E6y34DlG1Imr8FV42RV) -------\n// N=1 has NO missed-call variant: the lead has not been called yet.\nconst S = (id, name) => ({ id, name });\nconst STAGE = {\n  1: {\n    plain:  { normal: S('060f44a8-4cd8-4561-8c84-7150bfd57498', 'Day 1 Call A'),\n              mgr:    S('04ccf8e0-383f-4c17-9268-51020233d08b', 'Day 1 Call A (MGR)') }\n  },\n  2: {\n    plain:  { normal: S('4b1d7a88-87c0-422b-90e4-b48d16430900', 'Day 2 Call'),\n              mgr:    S('4b3023aa-515b-40f8-ad82-292ca685562e', 'Day 2 Call (MGR)') },\n    missed: { normal: S('40bdc040-8e97-4654-ae52-51e458c7f882', 'Day 2 Call (missed call)'),\n              mgr:    S('59069dd4-8071-45e2-820c-df565ab17132', 'Day 2 Call MGR (missed call)') }\n  },\n  3: {\n    plain:  { normal: S('f8407fb8-f94c-4443-baf9-b7d1c6f50d34', 'Day 3 Call'),\n              mgr:    S('5bfcb041-6abb-48d2-a60d-511af1af807f', 'Day 3 Call (MGR)') },\n    missed: { normal: S('b50e0792-a88c-4d0a-9e44-2d5cebfdef18', 'Day 3 Call (missed call)'),\n              mgr:    S('21b772e5-385d-47b7-8234-3138bd312a26', 'Day 3 Call MGR (missed call)') }\n  }\n};\nconst byN = STAGE[N] || {};\nconst bucket = (isMissed && byN.missed) ? byN.missed : byN.plain;   // N=1 -> always plain\nconst target = bucket ? bucket[isMGR ? 'mgr' : 'normal'] : null;\nconst target_stage_id = target ? target.id : '';\nconst target_stage_name = target ? target.name : '';\n\nconst EVENTLOGS_ID='7D9N71mEDfipN90zfV0j', EMAILHIST_ID='TcdjZt3fwFSZTgY6ngeE', CALLSUM_ID='ZVeEoK85i5EOhWt1HO1F', STARS_ID='E7XjZUePJBrJ99LnCD6e', REVIEWS_ID='kDel5db3cRFrNjqOwdNp';\nconst t = id => String(cf(id) || '').trim();\n\nreturn { json: {\n  contact_id: c.id,\n  email_opp_id,\n  target_stage_id,\n  target_stage_name,\n  is_missed: isMissed,\n  is_mgr: isMGR,\n  N,\n  // ---- Personalize Call Context (SUB) input contract ----\n  company_name: String(c.companyName || c.contactName || '').trim(),\n  contact_city: String(c.city || '').trim(),\n  stage: target_stage_name,\n  event_logs: t(EVENTLOGS_ID),\n  email_history: t(EMAILHIST_ID),\n  call_summary: t(CALLSUM_ID),\n  googlestars: cf(STARS_ID),\n  googlereviewscount: cf(REVIEWS_ID)\n}};\n"
      },
