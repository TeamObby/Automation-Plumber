        "jsCode": "// one opportunity per item (from Split Out) -> normalize the ids we need\nconst o = $json;\nconst contact_id = String((o.contact && o.contact.id) || o.contactId || '').trim();\nreturn { json: {\n  opp_id: String(o.id || '').trim(),\n  contact_id: contact_id,\n  current_stage_id: String(o.pipelineStageId || '').trim()\n}};"
