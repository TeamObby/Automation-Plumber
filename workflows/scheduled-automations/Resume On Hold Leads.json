      "id": "ghl-get-contact-resume",
      "name": "GHL: Get Contact",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpMultipleHeadersAuth": {
          "id": "DtotRKnzjDewbSsv",
          "name": "GHL [ Waterline Growth subaccount ] Multiple Headers Auth account"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Reads Resume Call At + Next Caller Stage custom fields."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// contact from the immediate predecessor (GHL: Get Contact)\nconst contact = ($json && $json.contact) ? $json.contact : ($json || {});\nconst cf = id => { const f = (contact.customFields || []).find(x => x.id === id); return f ? (f.value !== undefined ? f.value : f.field_value) : ''; };\nconst RESUME = 'u5VC5C59UlFZJDYOuw7N', NEXT = 'Tj0yopYbErXbwsTYTsCX';\n\nconst o = $('Extract Opp').item.json;                  // paired opportunity\nconst opp_id = String(o.opp_id || '').trim();\n\nconst raw = String(cf(RESUME) || '').trim().replace('T', ' ');\nconst next_stage = String(cf(NEXT) || '').trim().toLowerCase();\n\n// next_caller_stage slug -> target pipeline + stage (ids from AGENTS.md)\nconst STAGE_MAP = {\n  'cold_call_1':     { pipeline: '9E6y34DlG1Imr8FV42RV', stage: '060f44a8-4cd8-4561-8c84-7150bfd57498' },\n  'cold_call_2':     { pipeline: '9E6y34DlG1Imr8FV42RV', stage: '4cb90aaa-b8c3-40a8-b1e6-6585213b258c' },\n  'cold_call_3':     { pipeline: '9E6y34DlG1Imr8FV42RV', stage: '4b1d7a88-87c0-422b-90e4-b48d16430900' },\n  'day_1_attempt_1': { pipeline: 'TwW6o0JdPXUlcwvX0EvI', stage: '74c3e036-2d2f-4138-8806-b337973ccad5' }\n};\nconst target = STAGE_MAP[next_stage] || null;\n\n// resume gate (America/Los_Angeles). date-only -> due when the date is reached; with time -> due when date+time passed.\nconst now = DateTime.now().setZone('America/Los_Angeles');\nlet due = false, resume_kind = 'none';\nif (raw) {\n  const hasTime = /^\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}/.test(raw);\n  if (hasTime) {\n    const dt = DateTime.fromFormat(raw.slice(0, 16), 'yyyy-MM-dd HH:mm', { zone: 'America/Los_Angeles' });\n    due = dt.isValid && now >= dt;\n    resume_kind = 'datetime';\n  } else {\n    const d = DateTime.fromFormat(raw.slice(0, 10), 'yyyy-MM-dd', { zone: 'America/Los_Angeles' });\n    due = d.isValid && now.startOf('day') >= d.startOf('day');\n    resume_kind = 'date';\n  }\n}\n\nconst can_move = !!(opp_id && target && due);\nreturn { json: {\n  opp_id: opp_id,\n  contact_id: String(o.contact_id || '').trim(),\n  resume_call_at: raw,\n  resume_kind: resume_kind,\n  next_caller_stage: next_stage,\n  due: due,\n  can_move: can_move,\n  target_pipeline_id: target ? target.pipeline : '',\n  target_stage_id: target ? target.stage : ''\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        144
      ],
      "id": "evaluate-resume",
      "name": "Evaluate Resume",
      "notes": "Parses Resume Call At (date/date-time, PT); maps Next Caller Stage -> target pipeline/stage; sets can_move."
