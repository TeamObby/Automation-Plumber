      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Pending screener_log payloads (a Supabase write that failed), oldest first. Each becomes one replay\n// of the versioned upsert; a row whose JSON is unreadable is reported and left for a human.\nreturn $input.all().map(i => i.json).filter(p => p && p.id && p.pending_key).map(p => {\n  let row = null;\n  try { row = JSON.parse(p.row_json); } catch (e) { row = null; }\n  return { json: { id: p.id, pending_key: p.pending_key, body: row ? { r: row } : null, bad: !row } };\n}).filter(i => !i.json.bad);\n"
      }
    },
    {
      "name": "Supabase: replay screener_log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        672,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://cifgvpqfodglnhywrofy.supabase.co/rest/v1/rpc/screener_log_upsert",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 200
            }
          }
        }
      },
      "retryOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "supabaseApi": {
          "id": "oUnRFJd1TMI1LmTd",
          "name": "Supabase [ Waterline screener-helper ]"
        }
      }
    },
    {
      "name": "Replayed OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Pair each replay with its pending row; only a successful one is removed from the queue.\nconst sent = $('Pick replays').all().map(i => i.json);\nreturn $input.all().map((r, i) => ({ json: { id: sent[i] && sent[i].id, pending_key: sent[i] && sent[i].pending_key, ok: !(r.json && r.json.error) } }))\n  .filter(x => x.json.id && x.json.ok);\n"
      }
    },
