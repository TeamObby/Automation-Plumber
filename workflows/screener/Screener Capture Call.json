    {
      "name": "Route Replay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Dedupe on call_id, in three ways (the row is from Find Row; {} when the call is new):\n//   done      — classified AND written back to GHL: stop.\n//   writeback — classified, but the GHL write-back failed or never ran: reuse the stored verdict\n//               and retry the compare, without paying for the AI again.\n//   classify  — new call, or the AI failed last time: the full path.\nconst n = $('Normalize Call').first().json;\nconst row = $input.first().json || {};\nconst known = !!row.call_id;\nconst route = !known || row.ai_ok !== true ? 'classify' : (row.writeback_ok === true ? 'done' : 'writeback');\nreturn [{ json: route === 'writeback' ? Object.assign({}, row, { route }) : Object.assign({}, n, { route }) }];\n"
      }
    },
