      "credentials": {
        "httpMultipleHeadersAuth": {
          "id": "DtotRKnzjDewbSsv",
          "name": "GHL [ Waterline Growth subaccount ] Multiple Headers Auth account"
        }
      },
      "notes": "Creates one opp in Pending Review for this lead."
