      "id": "ghl-update-opp---pending-review",
      "name": "GHL: Update Opp -> Pending Review",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpMultipleHeadersAuth": {
          "id": "DtotRKnzjDewbSsv",
          "name": "GHL [ Waterline Growth subaccount ] Multiple Headers Auth account"
        }
      },
      "notes": "Re-open the existing opp into Pending Review (keeps id/history)."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ids = $('Plan Dedup').item.json.delete_ids || [];\nreturn ids.map(id => ({ json: { opp_id: String(id).trim() } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        -96
      ],
      "id": "extras-to-delete",
      "name": "Extras to delete",
