    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// priority order: rebooking > conversation > cold\n// Pipeline IDs inlined (previously read from the GHL Pipeline Stages sub-workflow)\nconst CALL_PIPES = [\n  { key: 'rebooking',    id: 'smoNRUaagZYOElKFLwtp' },   // Rebooking Call\n  { key: 'conversation', id: 'TwW6o0JdPXUlcwvX0EvI' },   // Active Conversation Call\n  { key: 'cold',         id: '9E6y34DlG1Imr8FV42RV' },   // Cold Outbound Call\n];\n\nconst resp = $json || {};\nconst opps = Array.isArray(resp.opportunities) ? resp.opportunities : (Array.isArray(resp) ? resp : []);\nconst pipeOf  = o => String((o && (o.pipelineId || o.pipeline_id)) || '').trim();\nconst stageOf = o => String((o && (o.pipelineStageId || o.pipeline_stage_id)) || '').trim();\n\n// which call pipelines does the lead currently hold an opp in?\nconst found = CALL_PIPES.filter(cp => cp.id && opps.some(o => pipeOf(o) === cp.id));\nconst distinctCount = found.length;\n\n// tiebreaker: highest-priority call pipeline that has an opp\nconst chosen = found.length ? found[0] : null;\nconst matchedOpp = chosen ? opps.find(o => pipeOf(o) === chosen.id) : null;\n\nlet anomaly = '';\nif (distinctCount === 0) anomaly = 'none';\nelse if (distinctCount > 1) anomaly = 'multiple';\n\nconst n = $('Normalize').item.json;\nreturn { json: {\n  route: chosen ? chosen.key : 'none',\n  matched_opp_id:      matchedOpp ? String(matchedOpp.id) : '',\n  matched_pipeline_id: chosen ? chosen.id : '',\n  matched_stage_id:    matchedOpp ? stageOf(matchedOpp) : '',\n  call_pipelines_found: distinctCount,\n  found_keys: found.map(f => f.key).join(',') || 'none',\n  anomaly,\n  contact_id: String(n.contact_id || ''),\n  instantly_lead_id: String(n.instantly_lead_id || ''),\n  email: String(n.email || ''),\n}};\n"
      },
